# GitHub Personal Access Token.
# Classic PAT: https://github.com/settings/tokens        -> needs the `repo` scope
# Fine-grained PAT (recommended):
#   https://github.com/settings/personal-access-tokens/new
#   Repository access: this repository only
#   Permissions: Contents rw, Issues rw, Pull requests rw, Actions rw,
#                Metadata r, Checks rw, Administration rw
ACCESS_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target repository as owner/repo. Every tool also accepts a `repo` argument,
# which overrides this value for that one call.
GITHUB_REPO=owner/repo-name